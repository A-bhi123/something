# Copy this file to server/.env and fill in both values. Never commit server/.env.
# If your password contains # or spaces, wrap it in quotes: APP_PASSWORD="my pass#word"

# The password visitors must enter to open the site.
APP_PASSWORD=

# A long random string used to sign login cookies (at least 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional settings (defaults shown)
# PORT=3001
# SESSION_HOURS=12
# Set to true when the site is served over HTTPS.
# COOKIE_SECURE=false
# Number of reverse proxies in front of the server (e.g. 1 on most hosting platforms).
# TRUST_PROXY=0
